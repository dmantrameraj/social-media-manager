APP_ENV=testing
APP_DEBUG=true

# Test database. Rebuilt by RefreshDatabase on every run -- never point this at
# a database holding anything you want to keep.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=smm_test
DB_USERNAME=smm
DB_PASSWORD=

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BCRYPT_ROUNDS=4
APP_KEY=
